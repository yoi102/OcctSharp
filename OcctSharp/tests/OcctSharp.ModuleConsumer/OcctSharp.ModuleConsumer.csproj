<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <OcctSharpPackageVersion Condition="'$(OcctSharpPackageVersion)' == ''">8.0.1-preview.25</OcctSharpPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OcctSharp.Modeling" Version="$(OcctSharpPackageVersion)" />
    <Compile Include="../Shared/BatchXProjectionWorkflow.cs" Link="BatchXProjectionWorkflow.cs" />
    <Compile Include="../Shared/BatchYGeometryWorkflow.cs" Link="BatchYGeometryWorkflow.cs" />
    <Compile Include="../Shared/BatchZValueWorkflow.cs" Link="BatchZValueWorkflow.cs" />
    <Compile Include="../Shared/BatchAAReferenceWorkflow.cs" Link="BatchAAReferenceWorkflow.cs" />
    <Compile Include="../Shared/BatchABOwnedWorkflow.cs" Link="BatchABOwnedWorkflow.cs" />
    <Compile Include="../Shared/BatchACOwnedUtilityWorkflow.cs" Link="BatchACOwnedUtilityWorkflow.cs" />
    <PackageReference Include="OcctSharp.Visualization" Version="$(OcctSharpPackageVersion)" />
  </ItemGroup>
</Project>

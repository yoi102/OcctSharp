<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OcctSharpBundledRuntimeRoot>$(MSBuildThisFileDirectory)runtime\win-x64</OcctSharpBundledRuntimeRoot>
    <OcctSharpBundledNativeRuntimeDir>$(OcctSharpBundledRuntimeRoot)\occt</OcctSharpBundledNativeRuntimeDir>
    <OcctSharpUseBundledNativeRuntime Condition="'$(OcctSharpUseBundledNativeRuntime)' == '' and Exists('$(OcctSharpBundledNativeRuntimeDir)\OcctSharp.Native.dll')">true</OcctSharpUseBundledNativeRuntime>
    <OcctSharpUseBundledNativeRuntime Condition="'$(OcctSharpUseBundledNativeRuntime)' == ''">false</OcctSharpUseBundledNativeRuntime>
    <OcctSharpNativeRuntimeDir Condition="'$(OcctSharpNativeRuntimeDir)' == '' and '$(OcctSharpUseBundledNativeRuntime)' == 'true'">$(OcctSharpBundledNativeRuntimeDir)</OcctSharpNativeRuntimeDir>
    <OcctSharpNativeRuntimeDir Condition="'$(OcctSharpNativeRuntimeDir)' == ''">$(MSBuildThisFileDirectory)artifacts\native\$(Configuration)</OcctSharpNativeRuntimeDir>
    <OcctSharpPackageVersion Condition="'$(OcctSharpPackageVersion)' == ''">8.0.1-preview.14</OcctSharpPackageVersion>
  </PropertyGroup>
</Project>

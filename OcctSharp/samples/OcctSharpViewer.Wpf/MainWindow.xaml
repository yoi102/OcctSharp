<Window x:Class="OcctSharpViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OcctSharpViewer.Wpf.Controls"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
      <WrapPanel Margin="8,5">
        <Button Content="Open STEP / IGES" Command="{Binding OpenModelCommand}" FontWeight="SemiBold" />
        <Separator Margin="8,3" />
        <Button Content="Fit All" Command="{Binding FitAllCommand}" />
        <Button Content="Axonometric" Command="{Binding AxonometricCommand}" />
        <Button Content="Front" Command="{Binding FrontCommand}" />
        <Button Content="Top" Command="{Binding TopCommand}" />
        <Button Content="Left" Command="{Binding LeftCommand}" />
        <Button Content="Right" Command="{Binding RightCommand}" />
        <Separator Margin="8,3" />
        <Button Content="Shaded" Command="{Binding ShadedCommand}" />
        <Button Content="Wireframe" Command="{Binding WireframeCommand}" />
        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
        <Button Content="Capture snapshot" Command="{Binding CaptureSnapshotCommand}" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
      <Grid Margin="12,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Margin="16,0,0,0" Foreground="#4B5563"
                   Text="{Binding SelectionText}" />
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="245" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Margin="10" Padding="16" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
        <StackPanel>
          <TextBlock Text="OcctSharp Viewer" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Margin="0,6,0,18" Foreground="#6B7280" Text="WPF / MVVM sample" />

          <TextBlock Text="Current model" FontWeight="SemiBold" />
          <TextBlock Margin="0,5,0,18" Text="{Binding CurrentFileName}" TextWrapping="Wrap" Foreground="#374151" />

          <TextBlock Text="Mouse controls" FontWeight="SemiBold" />
          <TextBlock Margin="0,7,0,0" Text="Right drag — rotate" />
          <TextBlock Margin="0,5,0,0" Text="Middle drag — pan" />
          <TextBlock Margin="0,5,0,0" Text="Wheel — zoom" />
          <TextBlock Margin="0,5,0,0" Text="Left click — select" />
          <TextBlock Margin="0,5,0,0" Text="Shift / Ctrl / Alt — add, toggle, remove" TextWrapping="Wrap" />

          <Border Margin="0,22,0,0" Padding="10" Background="#EFF6FF" CornerRadius="4">
            <TextBlock Foreground="#1E3A8A" TextWrapping="Wrap"
                       Text="The OCCT view is hosted in a native child window. WPF controls remain around the viewport." />
          </Border>
          <TextBlock Margin="0,16,0,6" Text="Copied review snapshot" FontWeight="SemiBold" />
          <Image Source="{Binding ReviewSnapshot}" MaxHeight="145" Stretch="Uniform" />
          <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"
                     Text="Opt-in CPU copy. WPF controls can overlay this snapshot, not the live HWND viewport." />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Margin="0,10,10,10" Background="#20252B" BorderBrush="#9CA3AF" BorderThickness="1">
        <controls:OcctViewportHost x:Name="Viewport" ViewerReady="OnViewerReady"
                                  SelectionChanged="OnSelectionChanged" ViewerError="OnViewerError" />
      </Border>
    </Grid>
  </DockPanel>
</Window>

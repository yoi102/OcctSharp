# Resolve the bridge's actual PE import closure instead of copying a historical
# distribution's DLL count or unrelated files from the dependency prefix.
cmake_minimum_required(VERSION 3.30)
if(POLICY CMP0207)
  cmake_policy(SET CMP0207 NEW)
endif()
if(NOT EXISTS "${BRIDGE}" OR NOT IS_DIRECTORY "${DEPENDENCY_BIN}" OR NOT IS_DIRECTORY "${OUTPUT}")
  message(FATAL_ERROR "Runtime closure inputs are missing.")
endif()
if(NOT EXISTS "${DUMPBIN}")
  message(FATAL_ERROR "The selected MSVC dumpbin tool is missing.")
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${DUMPBIN}")
file(REAL_PATH "$ENV{SystemRoot}/System32" system32)
file(REAL_PATH "$ENV{SystemRoot}/SysWOW64" syswow64)
if(NOT IS_DIRECTORY "${system32}")
  message(FATAL_ERROR "The actual Windows system directory is missing.")
endif()
function(occtsharp_system_path_regex result path)
  set(regex "^")
  string(REGEX MATCHALL "." characters "${path}")
  foreach(character IN LISTS characters)
    if(character MATCHES "[A-Za-z]")
      string(TOLOWER "${character}" lower)
      string(TOUPPER "${character}" upper)
      string(APPEND regex "[${lower}${upper}]")
    elseif(character STREQUAL "/" OR character STREQUAL "\\")
      string(APPEND regex [=[[/\\]]=])
    else()
      string(FIND ".^$*+?()[]{}|\\" "${character}" special)
      if(NOT special EQUAL -1)
        string(APPEND regex "\\${character}")
      else()
        string(APPEND regex "${character}")
      endif()
    endif()
  endforeach()
  string(APPEND regex [=[[/\\]]=])
  set(${result} "${regex}" PARENT_SCOPE)
endfunction()
occtsharp_system_path_regex(system32_regex "${system32}")
occtsharp_system_path_regex(syswow64_regex "${syswow64}")
file(GET_RUNTIME_DEPENDENCIES
  LIBRARIES "${BRIDGE}"
  DIRECTORIES "${DEPENDENCY_BIN}"
  RESOLVED_DEPENDENCIES_VAR resolved
  UNRESOLVED_DEPENDENCIES_VAR unresolved
  CONFLICTING_DEPENDENCIES_PREFIX conflict
  PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
  POST_EXCLUDE_REGEXES "${system32_regex}" "${syswow64_regex}")
if(unresolved OR conflict_FILENAMES)
  message(FATAL_ERROR "Runtime closure unresolved=${unresolved}; conflicts=${conflict_FILENAMES}")
endif()
file(REAL_PATH "${DEPENDENCY_BIN}" prefix)
file(REAL_PATH "${OUTPUT}" output_prefix)
string(TOLOWER "${prefix}" prefix_lower)
string(TOLOWER "${output_prefix}" output_lower)
string(TOLOWER "${system32}" system32_lower)
string(TOLOWER "${syswow64}" syswow64_lower)
foreach(dll IN LISTS resolved)
  file(REAL_PATH "${dll}" source)
  string(TOLOWER "${source}" source_lower)
  cmake_path(IS_PREFIX system32_lower "${source_lower}" NORMALIZE in_system32)
  cmake_path(IS_PREFIX syswow64_lower "${source_lower}" NORMALIZE in_syswow64)
  if(in_system32 OR in_syswow64)
    continue()
  endif()
  cmake_path(IS_PREFIX prefix_lower "${source_lower}" NORMALIZE inside)
  if(NOT inside)
    # A repeated build resolves DLLs already copied beside the bridge first.
    # Accept those only as exact copies of the selected installed port file.
    cmake_path(IS_PREFIX output_lower "${source_lower}" NORMALIZE in_output)
    get_filename_component(name "${source}" NAME)
    set(canonical "${prefix}/${name}")
    if(NOT in_output OR NOT EXISTS "${canonical}")
      message(FATAL_ERROR "Non-system runtime dependency escaped the pinned prefix: ${source}")
    endif()
    file(SHA256 "${source}" actual_hash)
    file(SHA256 "${canonical}" expected_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Copied runtime dependency differs from its pinned port: ${source}")
    endif()
    set(source "${canonical}")
  endif()
  get_filename_component(name "${source}" NAME)
  file(COPY_FILE "${source}" "${OUTPUT}/${name}" ONLY_IF_DIFFERENT)
endforeach()

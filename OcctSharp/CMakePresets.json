{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/native-vs18",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "windows-x64-local",
      "inherits": "windows-x64",
      "displayName": "Windows x64 using local OCCT 8.0.1",
      "cacheVariables": {
        "OCCT_ROOT": "$env{OCCTSHARP_OCCT_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-x64-local",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows-x64-local",
      "configuration": "Release"
    }
  ]
}

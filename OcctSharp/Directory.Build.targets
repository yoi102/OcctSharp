<Project>
  <ItemGroup Condition="'$(CopyOcctSharpNativeRuntime)' == 'true'">
    <_OcctSharpNativeBuildInput Include="$(MSBuildThisFileDirectory)CMakeLists.txt" />
    <_OcctSharpNativeBuildInput Include="$(MSBuildThisFileDirectory)CMakePresets.json" />
    <_OcctSharpNativeBuildInput Include="$(MSBuildThisFileDirectory)src\OcctSharp.Native\CMakeLists.txt" />
    <_OcctSharpNativeBuildInput Include="$(MSBuildThisFileDirectory)src\OcctSharp.Native\include\**\*" />
    <_OcctSharpNativeBuildInput Include="$(MSBuildThisFileDirectory)src\OcctSharp.Native\src\**\*" />
    <_OcctSharpNativeBuildInput Include="$(MSBuildThisFileDirectory)src\OcctSharp.Native\generated\**\*" />
  </ItemGroup>

  <Target Name="EnsureOcctSharpNativeRuntime"
          BeforeTargets="Build"
          Condition="'$(CopyOcctSharpNativeRuntime)' == 'true' and '$(OcctSharpUseBundledNativeRuntime)' != 'true'"
          Inputs="@(_OcctSharpNativeBuildInput)"
          Outputs="$(OcctSharpNativeRuntimeDir)\OcctSharp.Native.dll">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="Repository-native bootstrap currently supports Windows x64 only." />
    <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)eng\ensure-native.ps1&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>

  <Target Name="ValidateBundledOcctSharpNativeRuntime"
          BeforeTargets="Build"
          Condition="'$(CopyOcctSharpNativeRuntime)' == 'true' and '$(OcctSharpUseBundledNativeRuntime)' == 'true'">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="The committed OcctSharp runtime currently supports Windows x64 only." />
    <Error Condition="!Exists('$(OcctSharpNativeRuntimeDir)\OcctSharp.Native.dll')"
           Text="The committed OcctSharp native runtime is incomplete at '$(OcctSharpNativeRuntimeDir)'." />
  </Target>

  <Target Name="CopyOcctSharpNativeRuntimeFiles"
          AfterTargets="Build"
          Condition="'$(CopyOcctSharpNativeRuntime)' == 'true'">
    <ItemGroup>
      <_OcctSharpNativeRuntime Include="$(OcctSharpNativeRuntimeDir)\*.dll" />
      <_OcctSharpNativeRuntimeDestination Include="@(_OcctSharpNativeRuntime->'$(TargetDir)occt\%(Filename)%(Extension)')" />
      <_OcctSharpStaleNativeRuntime Include="$(TargetDir)occt\*.dll"
                                    Exclude="@(_OcctSharpNativeRuntimeDestination)" />
    </ItemGroup>
    <Error Condition="'@(_OcctSharpNativeRuntime)' == ''"
           Text="OcctSharp native runtime bootstrap did not produce DLLs at '$(OcctSharpNativeRuntimeDir)'." />
    <MakeDir Directories="$(TargetDir)occt" />
    <Delete Files="@(_OcctSharpStaleNativeRuntime)" />
    <Copy SourceFiles="@(_OcctSharpNativeRuntime)"
          DestinationFolder="$(TargetDir)occt"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

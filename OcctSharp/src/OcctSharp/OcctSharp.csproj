<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>.NET 10 bindings and friendly API for Open CASCADE Technology.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>OcctSharp</PackageId>
    <Version>0.1.0-alpha.40</Version>
    <Authors>OcctSharp contributors</Authors>
    <PackageDescription>.NET 10 bindings and friendly API for Open CASCADE Technology 8.0.1 on Windows x64.</PackageDescription>
    <PackageTags>OCCT;OpenCASCADE;CAD;STEP;STL;IGES;XDE</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\**\*.md"
          Exclude="..\..\..\docs\STATUS.md"
          Pack="true"
          PackagePath="docs\" />
    <None Include="..\..\packaging\OcctSharp.targets"
          Pack="true"
          PackagePath="buildTransitive\OcctSharp.targets" />
    <None Include="$(OcctSharpNativeRuntimeDir)\*.dll"
          Pack="true"
          PackagePath="buildTransitive\win-x64\occt\" />
    <None Include="$(OcctSharpOcctRoot)\LICENSE_LGPL_21.txt"
          Pack="true"
          PackagePath="licenses\occt\"
          Condition="Exists('$(OcctSharpOcctRoot)\LICENSE_LGPL_21.txt')" />
    <None Include="$(OcctSharpOcctRoot)\OCCT_LGPL_EXCEPTION.txt"
          Pack="true"
          PackagePath="licenses\occt\"
          Condition="Exists('$(OcctSharpOcctRoot)\OCCT_LGPL_EXCEPTION.txt')" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>.NET 10 bindings and friendly API for Open CASCADE Technology.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>OcctSharp</PackageId>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackageVersion>8.0.1-preview.3</PackageVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>OcctSharp contributors</Authors>
    <PackageDescription>.NET 10 bindings and friendly API for Open CASCADE Technology 8.0.1 on Windows x64.</PackageDescription>
    <PackageTags>OCCT;OpenCASCADE;CAD;STEP;STL;IGES;XDE</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\..\docs\**\*.md"
          Exclude="..\..\..\docs\STATUS.md"
          Pack="true"
          PackagePath="docs\" />
    <None Include="..\..\packaging\OcctSharp.targets"
          Pack="true"
          PackagePath="buildTransitive\OcctSharp.targets" />
    <None Include="$(OcctSharpNativeRuntimeDir)\*.dll"
          Pack="true"
          PackagePath="buildTransitive\win-x64\occt\" />
    <None Include="$(OcctSharpBundledRuntimeRoot)\licenses\**\*"
          Pack="true"
          PackagePath="licenses\%(RecursiveDir)" />
    <None Include="$(OcctSharpBundledRuntimeRoot)\THIRD_PARTY_NOTICES.md"
          Pack="true"
          PackagePath="licenses\" />
  </ItemGroup>
</Project>

* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.slnx text eol=crlf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.dll -text
OcctSharp/src/OcctSharp.Generator/Emission/*.txt text eol=lf
# Keep the qualified embedded template identity across Git checkouts.
OcctSharp/src/OcctSharp.Generator/Emission/transfer-records-native.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
OcctSharp/runtime/win-x64/licenses/** -text whitespace=-trailing-space
# Preserve generator-owned byte hashes, including mixed template line endings.
OcctSharp/generated/manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
OcctSharp/runtime/win-x64/runtime-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
OcctSharp/src/OcctSharp.Native/generated/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
OcctSharp/src/OcctSharp/Generated/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# CAD fixtures are identity-checked data; retain writer spacing and exact bytes.
OcctSharp/tests/Fixtures/** -text whitespace=-trailing-space,cr-at-eol
OcctSharp/tests/**/Fixtures/** -text whitespace=-trailing-space,cr-at-eol
# Preserve upstream port/patch bytes, including unified-diff context lines.
OcctSharp/config/dependencies/overlays/opencascade/** -text whitespace=-trailing-space,cr-at-eol
